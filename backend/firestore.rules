rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Durak ve hat verisi herkese açık okunur; yazma yalnızca sunucu tarafından
    // (Admin SDK anahtarı bu kuralları atlar) yapılır.
    match /duraklar/{durakKodu} {
      allow read: if true;
      allow write: if false;
    }

    match /hat/{belge} {
      allow read: if true;
      allow write: if false;
    }

    // Kullanıcıların kaydettiği favori güzergâhlar — yalnızca sahibi erişebilir.
    match /kullanicilar/{kullaniciId} {
      allow read, write: if request.auth != null && request.auth.uid == kullaniciId;

      match /favoriler/{favoriId} {
        allow read, write: if request.auth != null && request.auth.uid == kullaniciId;
      }
    }

    // Yukarıda eşleşmeyen her şey kapalı.
    match /{belge=**} {
      allow read, write: if false;
    }
  }
}
